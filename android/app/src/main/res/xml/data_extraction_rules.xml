<?xml version="1.0" encoding="utf-8"?>
<!-- Las cartas pueden pesar cientos de MB: no se respaldan en la nube ni se transfieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
